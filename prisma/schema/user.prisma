model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins Admin[]
  blogs  Blog[]

  comments Comment[]

  customers Customer[]
  otps      OTP[]

  productReviews ProductReview[]

  posOrders PosOrder[]

  supplierPaymentsCreated SupplierPayment[] @relation("SupplierPaymentCreatedBy")
  supplierPaymentsUpdated SupplierPayment[] @relation("SupplierPaymentUpdatedBy")
  suppliersCreated        Supplier[]        @relation("SupplierCreatedBy")
  suppliersUpdated        Supplier[]        @relation("SupplierUpdatedBy")
  locationsCreated        Location[]        @relation("LocationCreatedBy")
  locationsUpdated        Location[]        @relation("LocationUpdatedBy")
  purchaseOrdersCreated   PurchaseOrder[]   @relation("POCreatedBy")
  purchaseOrdersUpdated   PurchaseOrder[]   @relation("POUpdatedBy")
  goodsReceivesCreated    GoodsReceive[]    @relation("GRNCreatedBy")
  goodsReceivesUpdated    GoodsReceive[]    @relation("GRNUpdatedBy")
  stockMovements          StockMovement[]   @relation("MovementPerformedBy")
  stockTransfersCreated   StockTransfer[]   @relation("TransferCreatedBy")
  stockTransfersUpdated   StockTransfer[]   @relation("TransferUpdatedBy")
  supplierReturnsCreated  SupplierReturn[]  @relation("SRCreatedBy")
  supplierReturnsUpdated  SupplierReturn[]  @relation("SRUpdatedBy")
  customerReturnsCreated  CustomerReturn[]  @relation("CRCreatedBy")
  customerReturnsUpdated  CustomerReturn[]  @relation("CRUpdatedBy")
  stockAdjustmentsCreated StockAdjustment[] @relation("AdjustmentCreatedBy")
  stockAdjustmentsUpdated StockAdjustment[] @relation("AdjustmentUpdatedBy")
  damagesCreated          Damage[]          @relation("DamageCreatedBy")
  damagesUpdated          Damage[]          @relation("DamageUpdatedBy")
  lowStockConfigsCreated  LowStockConfig[]  @relation("LowStockConfigCreatedBy")
  lowStockConfigsUpdated  LowStockConfig[]  @relation("LowStockConfigUpdatedBy")
}

model Admin {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  name      String
  image     String?
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminNotifications AdminNotification[]
}

model OTP {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  code       String
  expiryDate DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
